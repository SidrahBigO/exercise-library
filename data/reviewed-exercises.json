      "instructions": {
        "form": [
          "Start in Three-Legged Downward Dog, with your hands firmly planted shoulder-width apart.",
          "Bend your right knee, open your hip, and bring your right heel towards your glutes.",
          "Rotate your right hip in a circular motion, making small, controlled circles with your knee.",
          "Lower your gaze, lengthen your spine and extend through the crown of your head.",
          "After completing a few reps, change direction."
        ],
        "proTips": [
          "Rotate your leg from your hip joint, not your lower back.",
          "Distribute your weight evenly through both your hands."
        ],
        "commonMistakes": [
          "Keep your shoulder blades lowered and away from your ears."
        ]
      },
